# Application
APP_NAME=Local AI Business Agent
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000
# Bootstrap key used when seeding the demo business (hashed at rest)
ADMIN_API_KEY_BOOTSTRAP=demo-api-key-stratford-comfort

# Database
DATABASE_URL=postgresql+psycopg://agent:agent@db:5432/agent

# Privacy / retention
RECORDING_STORAGE_ENABLED=false
TRANSCRIPT_RETENTION_DAYS=90
SEED_DEMO=true

# Voice provider: mock | retell | vapi
VOICE_PROVIDER=mock
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Calendar: mock | google (mock used when Google creds absent)
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# LLM: mock | openai_compat (hosted; never requires Ollama)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Notifications (email MVP; SMS interface stubbed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
NOTIFY_EMAIL_DRY_RUN=true

# ---------------------------------------------------------------------------
# Legacy Python FastAPI MVP (backend/)
# See backend/.env.example for DATABASE_URL, ADMIN_API_KEY_BOOTSTRAP, etc.
# ---------------------------------------------------------------------------
