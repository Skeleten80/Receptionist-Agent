# Application
APP_NAME=Local AI Business Agent
APP_ENV=development
LOG_LEVEL=INFO
# REQUIRED (min 32 chars). The API refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
# REQUIRED (min 32 chars). Admin API key for the seeded business (hashed at rest).
# The API refuses to start without it. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY_BOOTSTRAP=

# Database
DATABASE_URL=postgresql+psycopg://agent:agent@db:5432/agent

# Privacy / retention
RECORDING_STORAGE_ENABLED=false
TRANSCRIPT_RETENTION_DAYS=90
# Set true only for local development; never against production
SEED_DEMO=true

# Voice provider: mock | retell | vapi
VOICE_PROVIDER=mock
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Calendar: mock | google (mock used when Google creds absent)
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# LLM: mock | openai_compat (hosted; never requires Ollama)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Notifications (email MVP; SMS interface stubbed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
NOTIFY_EMAIL_DRY_RUN=true

# ---------------------------------------------------------------------------
# Legacy Python FastAPI MVP (backend/)
# See backend/.env.example for DATABASE_URL, ADMIN_API_KEY_BOOTSTRAP, etc.
# ---------------------------------------------------------------------------
